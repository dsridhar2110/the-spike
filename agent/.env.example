# Copy to agent/.env (git-ignored) and fill in.
#
# Phase 0 uses an AI Studio key — fastest path, free tier, no billing setup.
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here

# Phase 7 switches to Vertex AI instead (needs billing + aiplatform.googleapis.com):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional model override
# PLANNING_AGENT_MODEL=gemini-3.6-flash
